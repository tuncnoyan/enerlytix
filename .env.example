# Django Configuration (development defaults)
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=postgresql://enerlytix_user:enerlytix_password@localhost:5432/enerlytix

# Etainabl API Configuration
ETAINABL_API_KEY=your-etainabl-api-key
ETAINABL_API_URL=https://api.etainabl.com/2.0
ETAINABL_ACCOUNT_ID=6584fdd1c9ec4255

# Mailtrap API Configuration
MAILTRAP_API_TOKEN=your-mailtrap-api-token
DEFAULT_FROM_EMAIL=hello@demomailtrap.co
MAIL_REPLY_TO=support@example.com

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
PORT=8080
RAILWAY_PUBLIC_DOMAIN=
CSRF_TRUSTED_ORIGINS=

# Application Settings
API_TIMEOUT=30
PAGE_SIZE=50

# Usage and Invoice Import
CONSUMPTION_RETENTION_MONTHS=36
CONSUMPTION_IMPORT_RETRY_COUNT=1
CONSUMPTION_IMPORT_RETRY_BACKOFF_SECONDS=2
CONSUMPTION_HALFHOURLY_MONTHS=2
CONSUMPTION_MONTHLY_MONTHS=24
CONSUMPTION_INVOICE_MONTHS=12

# Production profile reference
# Copy .env.production.example to .env and set real secrets for production-like deploy checks:
#   DEBUG=False
#   ENVIRONMENT=production
#   SECRET_KEY=<long-random-value>
#   SECURE_SSL_REDIRECT=True
#   SESSION_COOKIE_SECURE=True
#   CSRF_COOKIE_SECURE=True
#   SECURE_HSTS_SECONDS=31536000
